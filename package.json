{
  "name": "clipeer",
  "version": "0.3.5",
  "description": "P2P shared clipboard with a local web interface",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "hyperswarm": "^4.8.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.Omikron-TNS.clipeer",
    "productName": "Clipeer",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "index.js",
      "updater.js",
      "words.js",
      "public/**",
      "build/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "OmikroN-TNS",
        "repo": "clipeer"
      }
    ]
  }
}
